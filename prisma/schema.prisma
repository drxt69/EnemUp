generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("STUDENT")
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  profile          Profile?
  accounts         Account[]
  sessions         Session[]
  roles            UserRole[]
  subscriptions    Subscription[]
  payments         Payment[]
  studentAnswers   StudentAnswer[]
  simulationRuns   SimulationRun[]
  essaySubmissions EssaySubmission[]
  studyPlans       StudyPlan[]
  progressRecords  ProgressRecord[]
  aiConversations  AIConversation[]
  notifications    Notification[]
  adminLogs        AdminLog[]        @relation("AdminActorLogs")
  couponsCreated   Coupon[]          @relation("CouponCreator")

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Profile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  phone              String?
  city               String?
  state              String?
  targetCourse       String?
  targetUniversity   String?
  currentLevel       String?
  weeklyAvailability Int?
  examDate           DateTime?
  learningGoal       String?
  difficulties       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Plan {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String?
  priceCents      Int
  currency        String   @default("BRL")
  billingInterval String
  trialDays       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  planId                 String
  provider               String    @default("MERCADOPAGO")
  providerSubscriptionId String?
  status                 String    @default("PENDING")
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  canceledAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId, status])
  @@index([providerSubscriptionId])
}

model Payment {
  id                String    @id @default(cuid())
  userId            String
  subscriptionId    String?
  provider          String    @default("MERCADOPAGO")
  providerPaymentId String?
  status            String    @default("PENDING")
  amountCents       Int
  currency          String    @default("BRL")
  paidAt            DateTime?
  metadata          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([providerPaymentId])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  discountPercent Int?
  discountCents   Int?
  maxRedemptions  Int?
  redeemedCount   Int       @default(0)
  startsAt        DateTime?
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdByUserId String?
  createdAt       DateTime  @default(now())

  createdBy User? @relation("CouponCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
}

model ExamYear {
  id        String   @id @default(cuid())
  year      Int      @unique
  createdAt DateTime @default(now())

  exams     Exam[]
  questions Question[]
}

model Area {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  subjects  Subject[]
  questions Question[]
}

model Subject {
  id        String   @id @default(cuid())
  areaId    String
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  area      Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  topics    Topic[]
  questions Question[]

  @@index([areaId])
}

model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  subject    Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions  QuestionTopic[]
  materials  Material[]
  studyTasks StudyTask[]

  @@index([subjectId])
}

model Exam {
  id        String   @id @default(cuid())
  yearId    String
  title     String
  color     String?
  language  String?
  sourceUrl String?
  createdAt DateTime @default(now())

  year      ExamYear   @relation(fields: [yearId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([yearId])
}

model EnemImportSource {
  id           String    @id @default(cuid())
  year         Int?
  title        String
  sourceUrl    String    @unique
  assetType    String
  status       String    @default("DISCOVERED")
  localPath    String?
  downloadedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  drafts QuestionImportDraft[]

  @@index([year])
  @@index([status])
}

model QuestionImportDraft {
  id               String   @id @default(cuid())
  sourceId         String
  externalRef      String?
  year             Int?
  questionNumber   Int?
  rawText          String
  statement        String?
  alternativesJson String?
  answerLabel      String?
  areaName         String?
  subjectName      String?
  status           String   @default("EXTRACTED")
  confidence       Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  source EnemImportSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, questionNumber])
  @@index([year])
  @@index([status])
}

model Question {
  id          String   @id @default(cuid())
  yearId      String?
  examId      String?
  areaId      String
  subjectId   String
  statement   String
  supportText String?
  source      String?
  sourceUrl   String?
  difficulty  String   @default("MEDIUM")
  explanation String?
  legalStatus String   @default("PENDING_REVIEW")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  year                ExamYear?            @relation(fields: [yearId], references: [id], onDelete: SetNull)
  exam                Exam?                @relation(fields: [examId], references: [id], onDelete: SetNull)
  area                Area                 @relation(fields: [areaId], references: [id])
  subject             Subject              @relation(fields: [subjectId], references: [id])
  alternatives        Alternative[]
  topics              QuestionTopic[]
  answers             StudentAnswer[]
  simulationQuestions SimulationQuestion[]

  @@index([areaId])
  @@index([subjectId])
  @@index([difficulty])
  @@index([isPublished])
}

model Alternative {
  id          String  @id @default(cuid())
  questionId  String
  label       String
  content     String
  isCorrect   Boolean @default(false)
  explanation String?
  sortOrder   Int     @default(0)

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  StudentAnswer[]

  @@unique([questionId, label])
  @@index([questionId])
}

model QuestionTopic {
  id         String @id @default(cuid())
  questionId String
  topicId    String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([questionId, topicId])
}

model StudentAnswer {
  id              String   @id @default(cuid())
  userId          String
  questionId      String
  alternativeId   String?
  simulationRunId String?
  isCorrect       Boolean
  answeredAt      DateTime @default(now())
  timeSpentSec    Int?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  alternative   Alternative?   @relation(fields: [alternativeId], references: [id], onDelete: SetNull)
  simulationRun SimulationRun? @relation(fields: [simulationRunId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([questionId])
  @@index([simulationRunId])
}

model Simulation {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("CUSTOM")
  durationMin Int?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions  SimulationQuestion[]
  runs       SimulationRun[]
  studyTasks StudyTask[]
}

model SimulationQuestion {
  id           String @id @default(cuid())
  simulationId String
  questionId   String
  sortOrder    Int    @default(0)

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([simulationId, questionId])
}

model SimulationRun {
  id             String    @id @default(cuid())
  userId         String
  simulationId   String
  status         String    @default("IN_PROGRESS")
  score          Float?
  correctCount   Int       @default(0)
  wrongCount     Int       @default(0)
  totalQuestions Int       @default(0)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulation Simulation      @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  answers    StudentAnswer[]
  result     Result?

  @@index([userId])
  @@index([simulationId])
}

model Result {
  id              String   @id @default(cuid())
  simulationRunId String   @unique
  totalScore      Float?
  areaBreakdown   String?
  strengths       String?
  weaknesses      String?
  recommendations String?
  createdAt       DateTime @default(now())

  simulationRun SimulationRun @relation(fields: [simulationRunId], references: [id], onDelete: Cascade)
}

model EssayTheme {
  id          String   @id @default(cuid())
  title       String
  prompt      String
  supportText String?
  source      String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions EssaySubmission[]
}

model EssaySubmission {
  id          String    @id @default(cuid())
  userId      String
  themeId     String
  title       String?
  content     String
  status      String    @default("SUBMITTED")
  submittedAt DateTime  @default(now())
  correctedAt DateTime?

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme      EssayTheme       @relation(fields: [themeId], references: [id])
  correction EssayCorrection?

  @@index([userId])
  @@index([themeId])
  @@index([status])
}

model EssayCorrection {
  id              String   @id @default(cuid())
  submissionId    String   @unique
  correctedBy     String?
  provider        String   @default("MANUAL")
  totalScore      Int
  generalFeedback String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submission   EssaySubmission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  competencies EssayCompetencyScore[]
}

model EssayCompetency {
  id          String   @id @default(cuid())
  number      Int      @unique
  name        String
  description String
  maxScore    Int      @default(200)
  createdAt   DateTime @default(now())

  scores EssayCompetencyScore[]
}

model EssayCompetencyScore {
  id           String  @id @default(cuid())
  correctionId String
  competencyId String
  score        Int
  feedback     String?

  correction EssayCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  competency EssayCompetency @relation(fields: [competencyId], references: [id])

  @@unique([correctionId, competencyId])
}

model StudyPlan {
  id              String    @id @default(cuid())
  userId          String
  title           String
  objective       String
  availability    String
  examDate        DateTime?
  currentLevel    String?
  difficultyNotes String?
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules StudySchedule[]

  @@index([userId])
  @@index([status])
}

model StudySchedule {
  id          String   @id @default(cuid())
  studyPlanId String
  date        DateTime
  title       String
  notes       String?
  createdAt   DateTime @default(now())

  studyPlan StudyPlan   @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  tasks     StudyTask[]

  @@index([studyPlanId])
  @@index([date])
}

model StudyTask {
  id            String   @id @default(cuid())
  scheduleId    String
  topicId       String?
  simulationId  String?
  type          String
  title         String
  durationMin   Int?
  exerciseCount Int?
  status        String   @default("PENDING")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  schedule   StudySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  topic      Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  simulation Simulation?   @relation(fields: [simulationId], references: [id], onDelete: SetNull)

  @@index([scheduleId])
  @@index([status])
}

model ProgressRecord {
  id         String   @id @default(cuid())
  userId     String
  areaId     String?
  subjectId  String?
  topicId    String?
  metric     String
  value      Float
  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([metric])
  @@index([recordedAt])
}

model Material {
  id          String   @id @default(cuid())
  topicId     String?
  title       String
  description String?
  type        String   @default("ARTICLE")
  content     String?
  fileUrl     String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  pdfs  PdfMaterial[]

  @@index([topicId])
  @@index([isPublished])
}

model PdfMaterial {
  id          String   @id @default(cuid())
  materialId  String
  fileName    String
  fileUrl     String
  pageCount   Int?
  generatedBy String?
  createdAt   DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String?
  title     String?
  context   String?
  provider  String   @default("mock")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  tokenCount     Int?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

model AdminLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  metadata    String?
  createdAt   DateTime @default(now())

  actor User? @relation("AdminActorLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
}
