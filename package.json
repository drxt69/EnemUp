{
  "name": "enem-up",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/**/*.test.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "db:setup": "node scripts/setup-db.mjs",
    "enem:discover": "node scripts/import/run-python-importer.mjs scripts/import/discover-enem-assets.py",
    "enem:extract": "node scripts/import/run-python-importer.mjs scripts/import/download-and-extract-enem.py",
    "enem:extract-local": "node scripts/import/run-python-importer.mjs scripts/import/download-and-extract-enem.py --local-archive",
    "enem:save-drafts": "tsx scripts/import/save-enem-drafts.ts",
    "enem:publish-drafts": "tsx scripts/import/publish-enem-drafts.ts",
    "enem:import": "npm run enem:discover -- --limit 10 && npm run enem:extract -- --limit 2 --max-pages 8 && npm run enem:save-drafts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "db:import:postgres": "node scripts/ops/migrate-sqlite-to-postgres.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "typescript": "^5"
  },
  "type": "module"
}
